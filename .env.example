# CareerCrew 容器部署环境变量（cp .env.example .env 后填写）
# ── 必填 ──
# 硅基流动 API（LLM/rerank/VLM 共用）
SILICONFLOW_API_KEY=
# 生产 JWT 密钥，≥32 字符：openssl rand -hex 32
AUTH_JWT_SECRET=

# ── 按需 ──
# MinerU 云端解析（知识库上传 PDF/图片时需要）
MINERU_API_KEY=
# LangSmith 追踪（settings.docker.yaml 默认 enabled: false）
LANGSMITH_API_KEY=
# 阿里云 OSS（头像存储；留空回退本地 data/uploads）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
