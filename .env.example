# CareerCrew 环境变量模板（cp .env.example .env 后填写；切勿提交真实值）
#
# 两种用法：
# - 容器部署（docker compose up）：DATABASE_URL 由 compose 注入，无需写在这里
# - 本地开发（uvicorn 直跑）：DATABASE_URL 必填（PostgreSQL 连接串）

# ── 本地开发必填 ──
# PostgreSQL 连接串（账号/会话/记忆/checkpoint 共用）
DATABASE_URL=postgresql://careercrew:careercrew@localhost:5432/careercrew

# ── 容器部署必填 / 本地按需 ──
# 阿里云百炼平台 API Key（通义千问 LLM / gte-rerank / qwen-vl 共用）
DASHSCOPE_API_KEY=
# BGE-M3 本地目录或 Hugging Face 模型标识；受保护评测环境必须显式提供可用模型
# CAREERCREW_EMBEDDING_MODEL_PATH=BAAI/bge-m3
# 生产 JWT 密钥，≥32 字符：openssl rand -hex 32（CAREERCREW_ENV=production 时强制校验）
AUTH_JWT_SECRET=

# ── 按需 ──
# 运行环境覆盖（默认 development；容器部署由 settings.docker.yaml 设为 production）
# CAREERCREW_ENV=development
# 认证库独立 DSN（未设置时回退 DATABASE_URL）
# AUTH_DATABASE_URL=
# agent 版本标记（进入追踪与评测记录）
# CAREERCREW_AGENT_VERSION=v0
# MinerU 云端解析（知识库上传 PDF/图片、rag.loaders.provider=api 时需要）
MINERU_API_KEY=
# LangSmith 追踪（settings.docker.yaml 默认 enabled: false）
LANGSMITH_API_KEY=
# 阿里云 OSS（头像存储；留空回退本地 data/uploads）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# ── 自动备份与恢复演练 ──
# 备份目录仅存储 PostgreSQL dump、Qdrant snapshots 与 uploads/parsed 压缩包
BACKUP_ROOT=data/backups
BACKUP_RETENTION_DAYS=30
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTIONS=careercrew_mm,careercrew_episodic_v2,careercrew_workspace_messages
# restore-drill 的隔离 PostgreSQL/Qdrant 目标（不回退到源端点）
# RESTORE_DATABASE_URL=postgresql://careercrew:careercrew@127.0.0.1:5434/restore_control
# RESTORE_QDRANT_URL=https://isolated-restore-qdrant.example
# RESTORE_QDRANT_API_KEY=
# 仅 Docker 文件恢复时指定隔离恢复容器；省略时使用 snapshot upload API
# RESTORE_QDRANT_CONTAINER=qdrant-restore

# ── 仅受保护发布/真实模型评测环境 ──
# 下面变量不要放入普通开发 .env；由 CI environment/secret 或受控 runner 注入
# CAREERCREW_RELEASE_TARGET=production
# CAREERCREW_RELEASE_RESTORE_DRILL=1
# CAREERCREW_RELEASE_SOURCE_RESOURCE_ID=prod/qdrant-cluster-a
# CAREERCREW_RELEASE_RESTORE_RESOURCE_ID=restore/qdrant-cluster-b
# CAREERCREW_EVAL_RUNTIME=1
# CAREERCREW_EVAL_RUN_ID=release_20260911
# CAREERCREW_EVAL_USER_ID=eval_release_20260911
# CAREERCREW_EVAL_TENANT_ATTESTATION=eval_release_20260911:release_20260911:provisioned
# Protected tenant provisioning authority; production eval must receive a
# matching nonce-scoped, time-limited receipt from this HTTPS endpoint.
# CAREERCREW_EVAL_TENANT_ATTESTATION_URL=https://<protected-provisioner>/v1/eval-tenants/attest
# CAREERCREW_EVAL_TENANT_ATTESTATION_TOKEN=
# CAREERCREW_EVAL_TENANT_ATTESTATION_NONCE=<provisioning-issued-unique-nonce>
# CAREERCREW_EVAL_DISABLE_REMOTE_TRACING=1
# Production evidence must be verified by a provider-side authority; local
# evidence JSON and booleans are not sufficient for release acceptance.
# CAREERCREW_RELEASE_EVIDENCE_VERIFIER_URL=https://<protected-release-verifier>/v1/verify
# CAREERCREW_RELEASE_EVIDENCE_VERIFIER_TOKEN=
